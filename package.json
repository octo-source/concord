{
  "name": "concord",
  "version": "0.1.0",
  "description": "Concord — instrument-grade qualitative text measurement. Explore in minutes, publish with honest statistics.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint server app/js demo tools",
    "lint:fix": "eslint server app/js demo tools --fix",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\""
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "fflate": "^0.8.2",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
